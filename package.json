{
  "name": "redact-secret-www",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-data.mjs && node scripts/check-i18n.mjs && node scripts/check-docs.mjs && node scripts/gen-data-types.mjs --check && node scripts/check-slots.mjs && tsc --noEmit && node scripts/build-site.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:slots": "node scripts/check-slots.mjs",
    "check:data": "node scripts/check-data.mjs",
    "check:taxonomy": "node scripts/sync-taxonomy.mjs --check",
    "sync:taxonomy": "node scripts/sync-taxonomy.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:data-types": "node scripts/gen-data-types.mjs --check",
    "data:types": "node scripts/gen-data-types.mjs",
    "test:data": "node --test scripts/test-data-contracts.mjs scripts/test-upstream-feeds.mjs scripts/test-i18n.mjs scripts/test-taxonomy-sync.mjs",
    "test:publish": "node --test scripts/test-publish.mjs",
    "slots:refresh": "node scripts/refresh-slots.mjs",
    "qualify:playground": "npm run build && node scripts/qualify-playground.mjs",
    "check:contract": "node scripts/check-build-contract.mjs",
    "check:architecture": "npm run build && node scripts/check-architecture.mjs",
    "check:first-paint": "npm run build && node scripts/check-first-paint.mjs",
    "check:community": "npm run build && node scripts/check-community.mjs"
  },
  "dependencies": {
    "@redact-secret/core": "0.1.0-beta.13",
    "preact": "^10.29.8",
    "preact-iso": "^2.12.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@preact/preset-vite": "^2.10.6",
    "@storybook/preact-vite": "^10.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "playwright": "1.63.0",
    "preact-render-to-string": "^6.7.0",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
