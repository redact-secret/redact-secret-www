{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.redactsecret.com/schemas/release-v1.schema.json",
  "title": "ReleaseV1",
  "description": "data/release.json: what each package in data/integrations.json has actually published, read from its registry by scripts/refresh-slots.mjs. Every record carries its own source, observation time, payload digest and freshness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "generator",
    "packages"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "release-v1"
    },
    "generatedAt": {
      "description": "When the refresh that wrote this file ran. Individual records keep their own observedAt, which is older for a stale record.",
      "$ref": "common-v1.schema.json#/$defs/timestamp"
    },
    "generator": {
      "const": "scripts/refresh-slots.mjs"
    },
    "packages": {
      "description": "Keyed by the package ids in data/integrations.json.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/packageRecord"
      }
    }
  },
  "$defs": {
    "packageRecord": {
      "title": "PackageRecord",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "observedAt",
        "freshness",
        "value"
      ],
      "properties": {
        "source": {
          "$ref": "common-v1.schema.json#/$defs/registrySource"
        },
        "observedAt": {
          "$ref": "common-v1.schema.json#/$defs/timestamp"
        },
        "freshness": {
          "$ref": "common-v1.schema.json#/$defs/freshness"
        },
        "staleSince": {
          "description": "Set only on a stale record: when the refresh that could not read the source ran.",
          "$ref": "common-v1.schema.json#/$defs/timestamp"
        },
        "digest": {
          "$ref": "common-v1.schema.json#/$defs/digest"
        },
        "value": {
          "$ref": "#/$defs/packageValue"
        },
        "declared": {
          "title": "DeclaredVersion",
          "description": "For a package its registry does not have: the version its repository declares, and where that was read.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "source"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "$ref": "common-v1.schema.json#/$defs/repositorySource"
            }
          }
        },
        "mirrors": {
          "title": "Mirrors",
          "description": "The same package published to other registries under another name.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pypi": {
              "$ref": "#/$defs/mirrorRecord"
            },
            "crates": {
              "$ref": "#/$defs/mirrorRecord"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "freshness": {
                "const": "stale"
              }
            },
            "required": [
              "freshness"
            ]
          },
          "then": {
            "required": [
              "staleSince"
            ]
          },
          "else": {
            "not": {
              "required": [
                "staleSince"
              ]
            }
          }
        },
        {
          "$comment": "A record that describes a published version was read from a fetched payload, so it carries that payload's digest.",
          "if": {
            "properties": {
              "source": {
                "required": [
                  "version"
                ]
              }
            }
          },
          "then": {
            "required": [
              "digest"
            ]
          }
        }
      ]
    },
    "mirrorRecord": {
      "title": "MirrorRecord",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "observedAt",
        "freshness",
        "value"
      ],
      "properties": {
        "source": {
          "$ref": "common-v1.schema.json#/$defs/registrySource"
        },
        "observedAt": {
          "$ref": "common-v1.schema.json#/$defs/timestamp"
        },
        "freshness": {
          "$ref": "common-v1.schema.json#/$defs/freshness"
        },
        "staleSince": {
          "description": "Set only on a stale record: when the refresh that could not read the source ran.",
          "$ref": "common-v1.schema.json#/$defs/timestamp"
        },
        "digest": {
          "$ref": "common-v1.schema.json#/$defs/digest"
        },
        "value": {
          "$ref": "#/$defs/mirrorValue"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "freshness": {
                "const": "stale"
              }
            },
            "required": [
              "freshness"
            ]
          },
          "then": {
            "required": [
              "staleSince"
            ]
          },
          "else": {
            "not": {
              "required": [
                "staleSince"
              ]
            }
          }
        },
        {
          "$comment": "A record that describes a published version was read from a fetched payload, so it carries that payload's digest.",
          "if": {
            "properties": {
              "source": {
                "required": [
                  "version"
                ]
              }
            }
          },
          "then": {
            "required": [
              "digest"
            ]
          }
        }
      ]
    },
    "mirrorValue": {
      "title": "MirrorValue",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "published": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "packageValue": {
      "title": "PackageValue",
      "description": "What the page may say about the package. Either the published version (and, per registry, its tag, peers or requirements), or `unpublished: true` when the registry does not have it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "name"
      ],
      "properties": {
        "registry": {
          "$ref": "common-v1.schema.json#/$defs/registry"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "published": {
          "type": "string",
          "format": "date"
        },
        "latest": {
          "description": "Where npm's `latest` dist-tag points.",
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "description": "The npm dist-tag this page installs from.",
          "type": "string",
          "minLength": 1
        },
        "peers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "requires": {
          "description": "PyPI requires_dist.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unpublished": {
          "const": true
        }
      },
      "if": {
        "required": [
          "unpublished"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "version"
              ]
            },
            {
              "required": [
                "published"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "version",
          "published"
        ]
      }
    }
  }
}
