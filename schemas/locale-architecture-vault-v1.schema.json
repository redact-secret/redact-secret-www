              "body": {
                "$ref": "locale-common-v1.schema.json#/$defs/text"
              }
            }
          }
        },
        "note": {
          "$ref": "locale-common-v1.schema.json#/$defs/rich"
        }
      }
    },
    "aTrapItClosesOnPurpose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eyebrow",
        "title",
        "lede",
