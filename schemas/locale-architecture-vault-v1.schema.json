      "properties": {
        "eyebrow": {
          "$ref": "locale-common-v1.schema.json#/$defs/text"
        },
        "title": {
          "$ref": "locale-common-v1.schema.json#/$defs/text"
        },
        "lede": {
          "$ref": "locale-common-v1.schema.json#/$defs/rich"
        },
        "cards": {
