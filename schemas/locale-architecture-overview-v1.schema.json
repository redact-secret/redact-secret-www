{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.redactsecret.com/schemas/locale-architecture-overview-v1.schema.json",
  "title": "LocaleArchitectureOverviewV1",
  "description": "i18n/<locale>/architecture/overview.json: the architecture hub (/architecture/) body in one locale. Page titles come from section.json; paths from the route registry.",
