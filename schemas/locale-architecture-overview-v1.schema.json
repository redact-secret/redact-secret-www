            "question": {
              "$ref": "locale-common-v1.schema.json#/$defs/rich"
            },
            "body": {
              "$ref": "locale-common-v1.schema.json#/$defs/rich"
            }
          }
        },
        "vault": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "question",
            "body"
          ],
          "properties": {
            "question": {
              "$ref": "locale-common-v1.schema.json#/$defs/rich"
            },
            "body": {
              "$ref": "locale-common-v1.schema.json#/$defs/rich"
            }
          }
        }
      }
    },
    "repos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eyebrow",
        "title",
        "lede",
        "tableLabel",
        "head",
        "rows"
      ],
      "properties": {
        "eyebrow": {
          "$ref": "locale-common-v1.schema.json#/$defs/rich"
        },
        "title": {
          "$ref": "locale-common-v1.schema.json#/$defs/rich"
