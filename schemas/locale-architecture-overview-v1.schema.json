  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "locale-architecture-overview-v1"
    },
    "locale": {
      "$ref": "locale-common-v1.schema.json#/$defs/locale"
    },
    "eyebrow": {
      "$ref": "locale-common-v1.schema.json#/$defs/rich"
