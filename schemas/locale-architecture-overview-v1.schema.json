            },
            "title": {
              "$ref": "locale-common-v1.schema.json#/$defs/rich"
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eyebrow",
            "title"
          ],
          "properties": {
            "eyebrow": {
              "$ref": "locale-common-v1.schema.json#/$defs/rich"
            },
            "title": {
              "$ref": "locale-common-v1.schema.json#/$defs/rich"
            }
          }
        },
        "boundaries": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eyebrow",
            "title"
          ],
          "properties": {
            "eyebrow": {
